<!DOCTYPE html>
<html>
<head>
  <title><%= user.username %>'s Site</title>
</head>
<body>
  <h1><%= user.username %></h1>
  <p><%= user.bio %></p>
  <hr>
  <h2>Posts</h2>
  <ul>
    <% posts.forEach(post => { %>
      <li>
        <a href="/u/<%= user.username %>/<%= post.id %>"><%= post.title %></a>
        <small>(<%= post.created_at %>)</small>
      </li>
    <% }) %>
  </ul>
</body>
</html>
